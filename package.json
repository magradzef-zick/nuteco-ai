{
  "name": "nuteco-ai-assistant",
  "version": "0.1.0",
  "private": true,
  "description": "Customer-service assistant for Nuteco Premium (Telegram + Instagram).",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "start": "node --import tsx src/index.ts",
    "register-webhook": "node --import tsx src/scripts/registerWebhook.ts",
    "subscribe-instagram-webhook": "node --import tsx src/scripts/subscribeInstagramWebhook.ts",
    "pretest": "rm -rf dist",
    "test": "node --import tsx --test"
  },
  "dependencies": {
    "better-sqlite3": "^11.3.0"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.11",
    "@types/node": "^20.14.0",
    "tsx": "^4.19.0",
    "typescript": "^5.6.0"
  }
}
