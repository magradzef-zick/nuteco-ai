# Telegram Bot API token (from @BotFather). Required.
TELEGRAM_BOT_TOKEN=

# A random string you choose yourself (e.g. `openssl rand -hex 32`). Registered
# with Telegram via `npm run register-webhook`, and checked on every incoming
# webhook request -- without it, anyone who discovers your webhook URL could
# send fake updates to this server. Strongly recommended in production.
TELEGRAM_WEBHOOK_SECRET_TOKEN=

# Gemini API key (from Google AI Studio: https://aistudio.google.com/apikey).
# Required -- this is what generates real assistant replies. The LLM provider
# is implemented behind src/llm/LlmProvider.ts, so a different provider could
# be swapped in later without touching the Conversation Engine; Gemini is the
# only one wired up today.
GEMINI_API_KEY=

# Which Gemini model to use. Optional -- defaults to a fast/cheap tier model
# appropriate for this project's mostly-retrieval-shaped task. Override if
# Google renames/deprecates the default.
GEMINI_MODEL=gemini-2.5-flash

# Telegram chat ID where manager escalation notifications should be sent.
MANAGER_NOTIFICATION_CHAT_ID=

# Path to the knowledge/ directory this assistant reads from.
KNOWLEDGE_BASE_DIR=./knowledge

# Path to the prompts/ directory (the system prompt template).
PROMPTS_DIR=./prompts

# Where the SQLite database file lives (customer identity + conversation state).
DATABASE_PATH=./data/nuteco.db

# Port the HTTP server (Telegram webhook receiver) listens on.
PORT=3000

# How often (in milliseconds) to re-run the startup token/health checks for
# as long as the process keeps running, so an expired/revoked credential
# (Telegram, Instagram, or Gemini) is caught proactively and logged, rather
# than only discovered the next time a real customer message fails.
# Optional -- defaults to 3600000 (1 hour). Set to 0 to disable the periodic
# re-check (the checks still always run once at startup).
TOKEN_HEALTH_CHECK_INTERVAL_MS=3600000

# --- Instagram Direct Messages (optional) ---
# All INSTAGRAM_* variables below are all-or-nothing: leave every one of
# them blank to run Telegram-only (nothing else changes). Set all of them
# to also handle Instagram Direct Messages on the same process.
#
# Full walkthrough, including the exact token-acquisition flow (this is not
# a single Dashboard button -- see docs/META_SETUP.md before attempting to
# fill these in): docs/META_SETUP.md

# The Facebook PAGE access token for the Instagram-linked Page -- not a
# User access token, not an "Instagram API with Instagram Login" token
# (those start with IGAA and are not valid here; this codebase talks to
# graph.facebook.com exclusively). Derived from a long-lived User token via
# GET /me/accounts, per Meta's documented flow -- see docs/META_SETUP.md.
# Required OAuth scopes: pages_show_list, instagram_basic,
# instagram_manage_messages, pages_read_engagement, pages_manage_metadata.
INSTAGRAM_PAGE_ACCESS_TOKEN=

# Your Meta app's App Secret (App Dashboard -> Settings -> Basic). Used to
# verify the X-Hub-Signature-256 header on every webhook delivery -- the
# Instagram equivalent of TELEGRAM_WEBHOOK_SECRET_TOKEN.
INSTAGRAM_APP_SECRET=

# A random string you choose yourself (e.g. `openssl rand -hex 32`).
# Entered into the Meta App Dashboard's webhook subscription form; Meta
# echoes it back on the one-time GET verification request, checked here
# before the subscription is accepted.
INSTAGRAM_VERIFY_TOKEN=

# The Instagram-linked Facebook Page ID (not the Instagram username).
# Used to subscribe the page to webhook events -- see
# `npm run subscribe-instagram-webhook`.
INSTAGRAM_PAGE_ID=

# Graph API version to call. Optional -- defaults to a recent stable
# version. Override if Meta deprecates the default.
INSTAGRAM_GRAPH_API_VERSION=v21.0

# Which Graph host to call. Optional -- defaults to https://graph.facebook.com.
# Meta serves Instagram messaging from two hosts, and which one is correct
# depends on how the token was issued, not on preference:
#   https://graph.facebook.com   -- Page token (Instagram API with Facebook login)
#   https://graph.instagram.com  -- Instagram-scoped token, starts with "IGAA"
#                                   (Instagram API with Instagram login)
# Calling the wrong host fails with a permission error that never names the
# real problem, so set this to match the token in INSTAGRAM_PAGE_ACCESS_TOKEN.
INSTAGRAM_GRAPH_BASE_URL=https://graph.facebook.com

# Run with: npm start (equivalent to `node --import tsx src/index.ts`; .env is
# loaded automatically if present -- see src/shared/loadEnvIfPresent.ts)
# Register the Telegram webhook once after deploying: npm run register-webhook -- https://your-domain.example/telegram/webhook
# Subscribe the Instagram webhook once after deploying (only if INSTAGRAM_* is set): npm run subscribe-instagram-webhook
